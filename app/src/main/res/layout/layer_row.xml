<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/layerTitle"
            style="@style/DeepDim.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/layer_hw" />

        <TextView
            android:id="@+id/layerValue"
            style="@style/DeepDim.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%" />

        <Switch
            android:id="@+id/layerSwitch"
            style="@style/DeepDim.Switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <com.deepdim.ParamSlider
        android:id="@+id/layerSlider"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="1dp" />

    <TextView
        android:id="@+id/layerHint"
        style="@style/DeepDim.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/layer_hw_hint" />
</LinearLayout>
