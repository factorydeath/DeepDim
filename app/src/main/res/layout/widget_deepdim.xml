<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widgetIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_moon"
            android:tint="@color/accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_title"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widgetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/accent"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetOff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/widget_off"
            android:textColor="@color/text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widgetRead"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/widget_read"
            android:textColor="@color/text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widgetNight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/widget_night"
            android:textColor="@color/text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widgetCinema"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/widget_cinema"
            android:textColor="@color/text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widgetMax"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/widget_max"
            android:textColor="@color/text"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
