<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E2314" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#99FFB454" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#262C36" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#3A4350" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14171D" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#232A34" />
        </shape>
    </item>
</selector>
